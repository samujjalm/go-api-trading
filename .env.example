# Settings for running the API natively (`make run` sets these for you).
# Copy to .env if your tooling reads env files; .env is git-ignored.
HTTP_ADDR=:8080
DATABASE_URL=postgres://trading:trading@localhost:5432/trading?sslmode=disable
TEST_DATABASE_URL=postgres://trading:trading@localhost:5432/trading_test?sslmode=disable
JWT_SECRET=dev-secret-change-me-dev-secret-change-me
JWT_ISSUER=go-service
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
